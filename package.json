{
  "name": "re-type-garden",
  "version": "0.1.0",
  "private": true,
  "description": "RE: Type Garden \u2014 portfolio reverse-engineering rebuild of Type Garden by Akshat Agarwal.",
  "author": "Rayina Ilham",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e:type": "node ./tests/e2e/type-mode.mjs",
    "qa:sweep": "node ./tests/e2e/qa-sweep.mjs",
    "test:parity": "node ./tests/parity/poster-parity.mjs",
    "test:e2e:export": "node ./tests/e2e/export.mjs",
    "test:e2e:poster": "node ./tests/e2e/poster-mode.mjs",
    "test:e2e:live": "node ./tests/e2e/live.mjs",
    "audit:leak": "node ./tools/leak-audit.mjs"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "playwright": "1.63.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
